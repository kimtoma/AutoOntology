[
  {
    "id": "Publication",
    "title": "현재 구현 · 후보부터 운영 반영까지",
    "target": false,
    "rules": [
      {
        "id": "SamePublication",
        "meaning": "그래프·검색·파일은 동일한 운영 버전을 읽는다"
      },
      {
        "id": "ReviewedBeforePublish",
        "meaning": "검토·검증·준비·현재 맥락이 갖춰져야 운영 전환한다"
      },
      {
        "id": "VerifiedHumanApproval",
        "meaning": "운영 반영 주체가 인증된 사람이어야 한다 — 현재 미구현 경계"
      }
    ]
  },
  {
    "id": "ContinuousChange",
    "title": "현재 구현 · 조직 지식의 변경 주기",
    "target": false,
    "rules": [
      {
        "id": "NoSilentPublication",
        "meaning": "변경 감지·수집·후보 생성만으로 운영본이 바뀌지 않는다"
      },
      {
        "id": "HistoricalOriginalKept",
        "meaning": "문서 교체 후에도 이전 원문을 보존한다"
      }
    ]
  },
  {
    "id": "KnowledgeQuery",
    "title": "Operational questions, citations and graph queries - current implementation",
    "target": false,
    "rules": [
      {
        "id": "NoFalseCompletion",
        "meaning": "전송이 완료된 응답 또는 실행 결과만 정상 종료로 표시한다"
      },
      {
        "id": "IncompleteNeverComplete",
        "meaning": "잘림·실패·취소를 완료 답변으로 표시하지 않는다"
      },
      {
        "id": "BoundBeforeConsumption",
        "meaning": "선택된 운영 버전·검색 또는 그래프의 일치를 먼저 확인한다"
      },
      {
        "id": "VerifiedOriginalOnly",
        "meaning": "다운로드하는 보존 원문의 식별·해시가 맞아야 한다"
      }
    ]
  },
  {
    "id": "SqlQuery",
    "title": "현재 구현 · 질문부터 결과 파일 복구까지",
    "target": false,
    "rules": [
      {
        "id": "NoFalseSuccess",
        "meaning": "실행된 결과가 있어야 완료로 기록한다"
      },
      {
        "id": "NoQueryReplay",
        "meaning": "같은 실행 기록의 파일 다운로드는 조회를 재실행하지 않는다"
      },
      {
        "id": "ApprovedScopeOnly",
        "meaning": "검증한 운영 범위의 SELECT만 실행한다"
      },
      {
        "id": "NoFailedDownload",
        "meaning": "실패·취소를 성공 CSV로 제공하지 않는다"
      }
    ]
  },
  {
    "id": "Restoration",
    "title": "현재 구현 · 확인한 지식을 새 운영 버전으로 복원",
    "target": false,
    "rules": [
      {
        "id": "SamePublication",
        "meaning": "복원 후 그래프·검색·파일이 같은 운영 버전을 사용한다"
      },
      {
        "id": "NoDuplicateCommit",
        "meaning": "같은 복원 재시도가 새 버전을 중복 생성하지 않는다"
      },
      {
        "id": "ExactConfirmedCommit",
        "meaning": "유효한 정확한 복원안만 전환한다"
      }
    ]
  },
  {
    "id": "AgentTarget",
    "title": "목표 설계 · 에이전트 준비와 인증된 사람의 확인",
    "target": true,
    "rules": [
      {
        "id": "VerifiedHumanApproval",
        "meaning": "에이전트가 자신을 승인할 수 없고 인증된 사람의 확인이 필요하다"
      },
      {
        "id": "ConsentBoundEffect",
        "meaning": "철회·만료·범위 변경 후에는 새 효과를 실행하지 않는다"
      },
      {
        "id": "AtMostOnce",
        "meaning": "응답 유실 후 재확인이 효과를 중복하지 않는다"
      }
    ]
  }
]