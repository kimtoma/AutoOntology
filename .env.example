# Ontology configuration. Copy to .env and edit; every value below is the default.
# `uv run onto init` writes .env for you (from this file when .env is missing).
# Precedence: shell environment > .env > built-in defaults. Never commit .env.
# Upstream (NVIDIA Auto Ontology) reads its environment at import time, so Ontology
# loads this file before it imports the engine.

# --- Paths ---
# Data directory: SQLite store (ontology.db), logs, PID files, kordoc, uploads.
# ONTOLOGY_HOME=<repo>/data
# Export root for `onto export` (one folder per snapshot revision: r0001/, ...).
# ONTOLOGY_EXPORTS_DIR=<repo>/exports
# Which .env to load (set it in the shell, not here).
# ONTOLOGY_ENV_FILE=<repo>/.env

# --- Ontology ---
# Workspace name = the name of the one ontology this home builds.
# ONTOLOGY_WORKSPACE=default
# Namespace of every IRI the ontology mints (Turtle/JSON-LD prefix `onto:`).
# ONTOLOGY_BASE_IRI=http://example.com/ontology#

# --- Service ---
# Ontology service port (web UI, REST API under /api, /v1 chat router).
ONTOLOGY_PORT=7800
# Port of the upstream engine backend.
BACKEND_PORT=3101
# INGESTION_SERVICE_URL (the URL upstream calls when a connection is created/deleted) is
# always derived from ONTOLOGY_PORT; a value set here is overridden.
# APP_URL is read only by upstream's own web frontend, which Ontology does not run.
# Web UI upload limit per request, in MB.
# ONTOLOGY_UPLOAD_MAX_MB=200
# Largest number of nodes the graph view receives (best-connected nodes are kept).
# ONTOLOGY_GRAPH_MAX_NODES=1500
# 1: unexpected CLI errors print the full traceback instead of one line + log path.
# ONTOLOGY_DEBUG=0
# Max wait for the Postgres advisory lock around vector-table setup, in seconds.
# ONTOLOGY_LOCK_TIMEOUT_S=300
# Max total wait for a lock on the SQLite store across retries, in seconds.
# ONTOLOGY_STORE_LOCK_TIMEOUT_S=120
# Language of the CLI messages: en | ko (default: ko when LC_ALL/LC_MESSAGES/LANG start
# with ko, else en). The web UI has its own English/한국어 switch in the header.
# ONTOLOGY_LANG=en

# --- Postgres 17 + pgvector (docker-compose.yml uses the same values) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ontology
POSTGRES_PASSWORD=ontology
# Catalog database; source databases are named ontology_src_<source>.
POSTGRES_DATABASE=ontology

# --- Model providers ---
# Chat provider: ollama (local) | openai (any OpenAI-compatible endpoint) |
# claude | codex (your logged-in CLI, see "Claude / Codex subscriptions" below).
ONTOLOGY_CHAT_PROVIDER=ollama
# Embedding provider: ollama | openai.
ONTOLOGY_EMBED_PROVIDER=ollama

# Ollama (`onto setup` pulls the models and builds the chat alias).
# OpenAI-compatible endpoint of the local Ollama server.
# ONTOLOGY_OLLAMA_ENDPOINT=http://localhost:11434/v1
# Chat model: an alias of qwen3:8b with num_ctx 16384 and thinking off. The openai/ prefix
# is part of the alias name: it makes upstream use its ChatOpenAI client.
# ONTOLOGY_OLLAMA_CHAT_MODEL=openai/qwen3:8b
# Embedding model (1024 dimensions).
# ONTOLOGY_OLLAMA_EMBED_MODEL=bge-m3
# 1: the /v1 router adds reasoning_effort=none so Ollama enforces JSON schemas.
# ONTOLOGY_OLLAMA_NO_THINK=1

# Generic OpenAI-compatible provider (OpenAI, NVIDIA build.nvidia.com, vLLM, LM Studio...).
# Base URL including /v1, e.g. https://integrate.api.nvidia.com/v1 or https://api.openai.com/v1
# ONTOLOGY_OPENAI_BASE_URL=
# API key; type it here yourself, never paste it into a chat or commit it.
# ONTOLOGY_OPENAI_API_KEY=
# Chat model name as the endpoint knows it (Ontology adds and strips the openai/ prefix).
# ONTOLOGY_OPENAI_CHAT_MODEL=
# Embedding model name (used when ONTOLOGY_EMBED_PROVIDER=openai).
# ONTOLOGY_OPENAI_EMBED_MODEL=
# Whole-request timeout of the router's openai passthrough, in seconds.
# ONTOLOGY_OPENAI_TIMEOUT_S=180

# Claude / Codex subscriptions (CLI): ONTOLOGY_CHAT_PROVIDER=claude or codex runs the
# `claude` / `codex` CLI you are logged in to (`claude auth login`, `codex login`) for every
# chat call. Prompts (table/column names, sample values, document text) go to Anthropic /
# OpenAI and count against your plan's usage limits (429 usage_limit). Embeddings still
# use ONTOLOGY_EMBED_PROVIDER (ollama or openai). No API key is needed or read.
# CLI binaries (default: claude / codex on PATH; name the real binary if that is a shim).
# ONTOLOGY_CLAUDE_BIN=
# ONTOLOGY_CODEX_BIN=
# Models: claude-sonnet-5-5 (default), claude-opus-5-5, claude-fable-5-1, claude-haiku-5-5,
# sonnet, opus, fable, haiku.
# ONTOLOGY_CLAUDE_MODEL=claude-sonnet-5-5
# Models: gpt-6-astra (default), gpt-5.5.
# ONTOLOGY_CODEX_MODEL=gpt-6-astra
# Optional codex reasoning effort (model_reasoning_effort), e.g. low, medium, high.
# ONTOLOGY_CODEX_REASONING_EFFORT=
# One request's deadline (slot wait + call + one schema re-ask), in seconds.
# ONTOLOGY_PROVIDER_TIMEOUT_S=120
# Concurrent CLI calls in the service.
# ONTOLOGY_PROVIDER_MAX_INFLIGHT=2
# Budget for validating one answer against its JSON schema, in seconds.
# ONTOLOGY_SCHEMA_VALIDATION_TIMEOUT_S=2

# Limits applied with the ollama chat provider unless set here.
# LLM_INVOKE_TIMEOUT_S=180
# LLM_MAX_INFLIGHT=2
# SEMANTIC_LLM_MAX_INFLIGHT=1

# Upstream model triplets (<PREFIX>_ENDPOINT/_API_KEY/_MODEL for DEFAULT_MODELS, REASONING,
# NON_REASONING, EMBED, RERANK) are derived from the provider settings above and passed to
# the engine; values set here are overridden.

# --- Documents ---
# CSV/TSV and legacy Word .doc documents are read natively.
# kordoc document engine (HWP/HWPX/PDF/DOCX/PPTX/XLSX, images; Node.js >= 20), optional:
# `uv run onto setup --docs` installs it into <ONTOLOGY_HOME>/kordoc.
# Use another kordoc install (path to dist/cli.js).
# KORDOC_CLI=
# Node binary for kordoc (default: node on PATH).
# KORDOC_NODE=
# Seconds per document (kordoc always runs offline, KORDOC_OFFLINE=1).
# ONTOLOGY_KORDOC_TIMEOUT=300
# OCR models (PP-OCRv5 korean, ~18 MB) for images and scanned PDFs: downloaded by
# `uv run onto tools install-kordoc` (skip with --skip-ocr-models).
# Rows a CSV/TSV *document* keeps (structured CSV sources load every row).
# ONTOLOGY_DOC_TABLE_MAX_ROWS=200
# Largest CSV/TSV/text/Markdown/HTML/.doc document the native readers accept, in bytes
# (larger files fail with FILE_TOO_LARGE).
# ONTOLOGY_DOC_MAX_BYTES=52428800
# Playground SQL: translate an English answer to a Korean question into Korean with the
# chat provider (one call, 30 s limit; the original stays available). 0 turns it off.
# ONTOLOGY_SQL_TRANSLATE=1
# Playground SQL: tool calls the engine's ReAct agent may make per question (each resends
# the whole transcript); exported as TEXT_TO_SQL_REACT_MAX_TOOL_CALLS (engine default 24)
# unless that is set.
# ONTOLOGY_SQL_MAX_TOOL_CALLS=12
# Playground SQL questions running at once; one more answers 429 sql_busy.
# ONTOLOGY_SQL_CONCURRENCY=2
# Optional Ollama vision model that describes image documents before their OCR text
# (e.g. gemma4:e4b, ~10 GB; `setup` pulls it). Empty: OCR text only.
# ONTOLOGY_VISION_MODEL=
# Chunking (tiktoken cl100k_base tokens): max chunk size, overlap when a section is split,
# small neighbouring sections are packed up to the last value.
# ONTOLOGY_CHUNK_TOKENS=1200
# ONTOLOGY_CHUNK_OVERLAP_TOKENS=100
# ONTOLOGY_CHUNK_PACK_TOKENS=400
# Parallel chunk extraction calls (default: 1 with the ollama chat provider, else 3).
# ONTOLOGY_LLM_WORKERS=
# Extraction output mode: auto | structured | json.
# ONTOLOGY_EXTRACT_MODE=auto
# Embedding cosine above which two concepts go to the merge judge.
# ONTOLOGY_MERGE_THRESHOLD=0.80
# Max merge-judge LLM calls per consolidation.
# ONTOLOGY_MERGE_MAX_JUDGE=100

# --- Alignment (documents -> structured Terms) ---
# Candidate Term cosine floor (top 5 candidates).
# ONTOLOGY_ALIGN_MIN_SIM=0.55
# Judge confidence needed to apply a `same` verdict.
# ONTOLOGY_ALIGN_MIN_CONF=0.7
# 1: a metric concept may be judged `same` as a Term.
# ONTOLOGY_ALIGN_ALLOW_METRIC_SAME=0

# --- Remote access (Tailscale Serve) ---
# Tailnet hostnames `tailscale serve` forwards to this service (comma-separated, e.g.
# box.example.ts.net). A request on one of them needs the Tailscale-User-Login header that
# tailscaled adds for tailnet clients only; public Funnel traffic is refused. Never use
# `tailscale funnel`. Restart with `uv run onto down && uv run onto up`.
# Local hosts (localhost, 127.0.0.1, [::1]) are refused here.
# ONTOLOGY_TAILSCALE_HOSTS=
# Tailnet logins allowed on those hostnames (comma-separated; empty = any tailnet identity).
# ONTOLOGY_TAILSCALE_LOGINS=

# --- Accounts (sign-in) ---
# off: no accounts (everyone past the host guard may do everything; the default).
# accounts: users sign in (email + password, or a one-time link) and get a session cookie.
# Create the first admin with `uv run onto user create <email> --admin`.
# ONTOLOGY_AUTH=off
# Session lifetime in hours (1..720).
# ONTOLOGY_SESSION_HOURS=12
# Base URL that sign-in and invitation links point at (empty = the request's own URL; the
# CLI falls back to http://127.0.0.1:<port>). An https URL also marks the cookie Secure.
# ONTOLOGY_PUBLIC_URL=https://ontology.example.com
# Outgoing mail for sign-in links (empty host = no mail; admins copy links from
# `uv run onto user link <email>`). Port 465 = implicit TLS; otherwise STARTTLS
# unless ONTOLOGY_SMTP_STARTTLS=0. The password is a secret: keep it in .env only.
# ONTOLOGY_SMTP_HOST=
# ONTOLOGY_SMTP_PORT=587
# ONTOLOGY_SMTP_USER=
# ONTOLOGY_SMTP_PASSWORD=
# ONTOLOGY_SMTP_FROM=
# ONTOLOGY_SMTP_STARTTLS=1
# Playground questions (chat, SQL, SPARQL) on archived projects: allow | deny.
# ONTOLOGY_ARCHIVED_PLAYGROUND=allow
# Workflows: on (schedules and on_action triggers fire) | off (manual runs only).
# ONTOLOGY_WORKFLOWS=on
# The time zone workflow schedules use (IANA name; empty = the system's local time).
# ONTOLOGY_TZ=Asia/Seoul
# Reserved for single sign-on (OpenID Connect), not read yet:
# ONTOLOGY_OIDC_ISSUER= ONTOLOGY_OIDC_CLIENT_ID= ONTOLOGY_OIDC_CLIENT_SECRET=
# ONTOLOGY_OIDC_SCOPES=openid email profile

# --- Tests ---
# 1: run the integration tests (need a real Postgres + Ollama); set in the shell.
# ONTOLOGY_INTEGRATION=0
