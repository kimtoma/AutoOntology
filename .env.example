# AutoOntology configuration. Copy to .env and edit; every value below is the default.
# `uv run autoontology init` writes .env for you (from this file when .env is missing).
# Precedence: shell environment > .env > built-in defaults. Never commit .env.
# Upstream (NVIDIA Auto Ontology) reads its environment at import time, so AutoOntology
# loads this file before it imports the engine.

# --- Paths ---
# Data directory: SQLite store (autoontology.db), logs, PID files, kordoc, uploads.
# AUTOONTOLOGY_HOME=<repo>/data
# Export root for `autoontology export` (one folder per snapshot revision: r0001/, ...).
# AUTOONTOLOGY_EXPORTS_DIR=<repo>/exports
# Which .env to load (set it in the shell, not here).
# AUTOONTOLOGY_ENV_FILE=<repo>/.env

# --- Ontology ---
# Workspace name = the name of the one ontology this home builds.
# AUTOONTOLOGY_WORKSPACE=default
# Namespace of every IRI the ontology mints (Turtle/JSON-LD prefix `ao:`).
# AUTOONTOLOGY_BASE_IRI=http://example.com/autoontology#

# --- Service ---
# AutoOntology service port (web UI, REST API under /api, /v1 chat router).
AUTOONTOLOGY_PORT=7800
# Port of the upstream engine backend.
BACKEND_PORT=3101
# INGESTION_SERVICE_URL (the URL upstream calls when a connection is created/deleted) is
# always derived from AUTOONTOLOGY_PORT; a value set here is overridden.
# APP_URL is read only by upstream's own web frontend, which AutoOntology does not run.
# Web UI upload limit per request, in MB.
# AUTOONTOLOGY_UPLOAD_MAX_MB=200
# Largest number of nodes the graph view receives (best-connected nodes are kept).
# AUTOONTOLOGY_GRAPH_MAX_NODES=1500
# 1: unexpected CLI errors print the full traceback instead of one line + log path.
# AUTOONTOLOGY_DEBUG=0
# Max wait for the Postgres advisory lock around vector-table setup, in seconds.
# AUTOONTOLOGY_LOCK_TIMEOUT_S=300
# Max total wait for a lock on the SQLite store across retries, in seconds.
# AUTOONTOLOGY_STORE_LOCK_TIMEOUT_S=120
# Language of the CLI messages: en | ko (default: ko when LC_ALL/LC_MESSAGES/LANG start
# with ko, else en). The web UI has its own English/한국어 switch in the header.
# AUTOONTOLOGY_LANG=en

# --- Postgres 17 + pgvector (docker-compose.yml uses the same values) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=autoontology
POSTGRES_PASSWORD=autoontology
# Catalog database; source databases are named autoontology_src_<source>.
POSTGRES_DATABASE=autoontology

# --- Model providers ---
# Chat provider: ollama (local) | openai (any OpenAI-compatible endpoint) |
# claude | codex (your logged-in CLI, see "Claude / Codex subscriptions" below).
AUTOONTOLOGY_CHAT_PROVIDER=ollama
# Embedding provider: ollama | openai.
AUTOONTOLOGY_EMBED_PROVIDER=ollama

# Ollama (`autoontology setup` pulls the models and builds the chat alias).
# OpenAI-compatible endpoint of the local Ollama server.
# AUTOONTOLOGY_OLLAMA_ENDPOINT=http://localhost:11434/v1
# Chat model: an alias of qwen3:8b with num_ctx 16384 and thinking off. The openai/ prefix
# is part of the alias name: it makes upstream use its ChatOpenAI client.
# AUTOONTOLOGY_OLLAMA_CHAT_MODEL=openai/qwen3:8b
# Embedding model (1024 dimensions).
# AUTOONTOLOGY_OLLAMA_EMBED_MODEL=bge-m3
# 1: the /v1 router adds reasoning_effort=none so Ollama enforces JSON schemas.
# AUTOONTOLOGY_OLLAMA_NO_THINK=1

# Generic OpenAI-compatible provider (OpenAI, NVIDIA build.nvidia.com, vLLM, LM Studio...).
# Base URL including /v1, e.g. https://integrate.api.nvidia.com/v1 or https://api.openai.com/v1
# AUTOONTOLOGY_OPENAI_BASE_URL=
# API key; type it here yourself, never paste it into a chat or commit it.
# AUTOONTOLOGY_OPENAI_API_KEY=
# Chat model name as the endpoint knows it (AutoOntology adds and strips the openai/ prefix).
# AUTOONTOLOGY_OPENAI_CHAT_MODEL=
# Embedding model name (used when AUTOONTOLOGY_EMBED_PROVIDER=openai).
# AUTOONTOLOGY_OPENAI_EMBED_MODEL=
# Whole-request timeout of the router's openai passthrough, in seconds.
# AUTOONTOLOGY_OPENAI_TIMEOUT_S=180

# Claude / Codex subscriptions (CLI): AUTOONTOLOGY_CHAT_PROVIDER=claude or codex runs the
# `claude` / `codex` CLI you are logged in to (`claude auth login`, `codex login`) for every
# chat call. Prompts (table/column names, sample values, document text) go to Anthropic /
# OpenAI and count against your plan's usage limits (429 usage_limit). Embeddings still
# use AUTOONTOLOGY_EMBED_PROVIDER (ollama or openai). No API key is needed or read.
# CLI binaries (default: claude / codex on PATH; name the real binary if that is a shim).
# AUTOONTOLOGY_CLAUDE_BIN=
# AUTOONTOLOGY_CODEX_BIN=
# Models: claude-sonnet-5-5 (default), claude-opus-5-5, claude-fable-5-1, claude-haiku-5-5,
# sonnet, opus, fable, haiku.
# AUTOONTOLOGY_CLAUDE_MODEL=claude-sonnet-5-5
# Models: gpt-6-astra (default), gpt-5.5.
# AUTOONTOLOGY_CODEX_MODEL=gpt-6-astra
# Optional codex reasoning effort (model_reasoning_effort), e.g. low, medium, high.
# AUTOONTOLOGY_CODEX_REASONING_EFFORT=
# One request's deadline (slot wait + call + one schema re-ask), in seconds.
# AUTOONTOLOGY_PROVIDER_TIMEOUT_S=120
# Concurrent CLI calls in the service.
# AUTOONTOLOGY_PROVIDER_MAX_INFLIGHT=2
# Budget for validating one answer against its JSON schema, in seconds.
# AUTOONTOLOGY_SCHEMA_VALIDATION_TIMEOUT_S=2

# Limits applied with the ollama chat provider unless set here.
# LLM_INVOKE_TIMEOUT_S=180
# LLM_MAX_INFLIGHT=2
# SEMANTIC_LLM_MAX_INFLIGHT=1

# Upstream model triplets (<PREFIX>_ENDPOINT/_API_KEY/_MODEL for DEFAULT_MODELS, REASONING,
# NON_REASONING, EMBED, RERANK) are derived from the provider settings above and passed to
# the engine; values set here are overridden.

# --- Documents ---
# CSV/TSV and legacy Word .doc documents are read natively.
# kordoc document engine (HWP/HWPX/PDF/DOCX/PPTX/XLSX, images; Node.js >= 20), optional:
# `uv run autoontology setup --docs` installs it into <AUTOONTOLOGY_HOME>/kordoc.
# Use another kordoc install (path to dist/cli.js).
# KORDOC_CLI=
# Node binary for kordoc (default: node on PATH).
# KORDOC_NODE=
# Seconds per document (kordoc always runs offline, KORDOC_OFFLINE=1).
# AUTOONTOLOGY_KORDOC_TIMEOUT=300
# OCR models (PP-OCRv5 korean, ~18 MB) for images and scanned PDFs: downloaded by
# `uv run autoontology tools install-kordoc` (skip with --skip-ocr-models).
# Rows a CSV/TSV *document* keeps (structured CSV sources load every row).
# AUTOONTOLOGY_DOC_TABLE_MAX_ROWS=200
# Largest CSV/TSV/text/Markdown/HTML/.doc document the native readers accept, in bytes
# (larger files fail with FILE_TOO_LARGE).
# AUTOONTOLOGY_DOC_MAX_BYTES=52428800
# Optional Ollama vision model that describes image documents before their OCR text
# (e.g. gemma4:e4b, ~10 GB; `setup` pulls it). Empty: OCR text only.
# AUTOONTOLOGY_VISION_MODEL=
# Chunking (tiktoken cl100k_base tokens): max chunk size, overlap when a section is split,
# small neighbouring sections are packed up to the last value.
# AUTOONTOLOGY_CHUNK_TOKENS=1200
# AUTOONTOLOGY_CHUNK_OVERLAP_TOKENS=100
# AUTOONTOLOGY_CHUNK_PACK_TOKENS=400
# Parallel chunk extraction calls (default: 1 with the ollama chat provider, else 3).
# AUTOONTOLOGY_LLM_WORKERS=
# Extraction output mode: auto | structured | json.
# AUTOONTOLOGY_EXTRACT_MODE=auto
# Embedding cosine above which two concepts go to the merge judge.
# AUTOONTOLOGY_MERGE_THRESHOLD=0.80
# Max merge-judge LLM calls per consolidation.
# AUTOONTOLOGY_MERGE_MAX_JUDGE=100

# --- Alignment (documents -> structured Terms) ---
# Candidate Term cosine floor (top 5 candidates).
# AUTOONTOLOGY_ALIGN_MIN_SIM=0.55
# Judge confidence needed to apply a `same` verdict.
# AUTOONTOLOGY_ALIGN_MIN_CONF=0.7
# 1: a metric concept may be judged `same` as a Term.
# AUTOONTOLOGY_ALIGN_ALLOW_METRIC_SAME=0

# --- Remote access (Tailscale Serve) ---
# Tailnet hostnames `tailscale serve` forwards to this service (comma-separated, e.g.
# box.example.ts.net). A request on one of them needs the Tailscale-User-Login header that
# tailscaled adds for tailnet clients only; public Funnel traffic is refused. Never use
# `tailscale funnel`. Restart with `uv run autoontology down && uv run autoontology up`.
# Local hosts (localhost, 127.0.0.1, [::1]) are refused here.
# AUTOONTOLOGY_TAILSCALE_HOSTS=
# Tailnet logins allowed on those hostnames (comma-separated; empty = any tailnet identity).
# AUTOONTOLOGY_TAILSCALE_LOGINS=

# --- Tests ---
# 1: run the integration tests (need a real Postgres + Ollama); set in the shell.
# AUTOONTOLOGY_INTEGRATION=0
